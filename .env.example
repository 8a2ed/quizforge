# Environment Variables — QuizForge
# Copy this file to .env.local and fill in all values

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL runtime URL (use your provider's pooled/transaction-pooler URL).
# Prisma Postgres: pooled.db.prisma.io. Keep connection_limit low on serverless.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/quizforge?sslmode=require&connection_limit=1"
# Direct URL for Prisma CLI schema operations (db push / migrate / Studio).
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/quizforge?sslmode=require"
# Optional per-instance Prisma pool size. Defaults to 1 to protect serverless DB limits.
DB_CONNECTION_LIMIT="1"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
NEXT_PUBLIC_BOT_USERNAME="agridmu_bot"

# ─── Webhook ──────────────────────────────────────────────────────────────────
# The public URL where Telegram will POST poll_answer updates
# For local dev, use ngrok: ngrok http 3000
CRON_SECRET="your-random-cron-secret"
WEBHOOK_SECRET="your-random-webhook-secret"
WEBHOOK_BASE_URL="https://your-domain.com"

# ─── Azure (Production) ───────────────────────────────────────────────────────
AZURE_APP_NAME="quizforge"
AZURE_RESOURCE_GROUP="quizforge-rg"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="QuizForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
